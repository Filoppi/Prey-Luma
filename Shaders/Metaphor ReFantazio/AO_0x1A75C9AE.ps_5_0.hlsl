	r5.zw = screenParams.xy * r5.zw;
	r5.zw = round(r5.zw);
	r7.xy = screenParams.zw * r5.zw;
	r8.xyz = r7.yyy * r3.xyz;
	r8.xyz = r7.xxx * r2.xyz + r8.xyz;
	r2.w = dot(r8.xy, r8.xy);
	r2.w = rsqrt(r2.w);
	r7.z = -r8.z * r2.w + biasParams.y;
	r6.xy = r1.ww * r7.xy + r6.xy;
	r6.xy = screenParams.xy * r6.xy;
	r6.xy = round(r6.xy);
	r7.xy = screenParams.zw * r6.xy;
