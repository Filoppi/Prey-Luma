#include "Includes/Common.hlsl"

cbuffer GFD_PSCONST_SYSTEM : register(b0)
{
	float2 resolution : packoffset(c0);
	float2 resolutionRev : packoffset(c0.z);
	float4x4 mtxView : packoffset(c1);
	float4x4 mtxInvView : packoffset(c5);
	float4x4 mtxProj : packoffset(c9);
	float4x4 mtxInvProj : packoffset(c13);
	float4 invProjParams : packoffset(c17);
}

cbuffer GFD_PSCONST_SSAO : register(b12)
{
	float4 uvToViewParams : packoffset(c0);
	float4 screenParams : packoffset(c1);
	float4 radiusParams : packoffset(c2);
	float4 focalParams : packoffset(c3);
	float4 biasParams : packoffset(c4);
	float4 compositeColor : packoffset(c5);
}

SamplerState pointSampler_s : register(s0);
SamplerState linearSampler_s : register(s1);
Texture2D<float4> depthTexture : register(t0);
Texture2D<float4> gbuffer1Texture : register(t1);
Texture2D<float4> randomTexture : register(t2);

uint RandomFromIndex(int i)
{
	// Convert index to float, apply some constants and sine hash
	return uint(frac(sin(float(i) * 12.9898 + 78.233) * 43758.5453) * 32.0f);
}

float RandomFromIndex2(int i)
{
	// Convert index to float, apply some constants and sine hash
	return uint(frac(sin(float(i) * 14.9898 + 72.233) * 48758.5453) * 32.0f);
}

void main(
	float4 v0 : SV_POSITION0,
	float2 v1 : TEXCOORD0,
	out float2 o0 : SV_Target0)
{
	float4 r0,r1,r2,r3,r4,r5,r6,r7,r8,r9;
	uint4 bitmask, uiDest;
	float4 fDest;

	r0.x = depthTexture.Sample(pointSampler_s, v1.xy).x;
	r0.x = invProjParams.z + r0.x;
	r0.x = invProjParams.w / r0.x;
	r0.w = -r0.x;
	r1.x = gbuffer1Texture.Sample(pointSampler_s, v1.xy).w;
	r1.x = 255 * r1.x;
	r1.x = (uint)r1.x;
	r1.x = (int)r1.x & 2;
	if (r1.x != 0) {
		r0.x = 1;
		o0.xy = r0.xw;
		return;
	}
	r1.x = focalParams.x * radiusParams.x;
	r1.x = 0.5 * r1.x;
	r1.x = r1.x / r0.w;
	r1.x = screenParams.x * r1.x;
	r1.y = r1.x < 1;
	if (r1.y != 0) {
		r0.y = 1;
		o0.xy = r0.yw;
		return;
	}
	r1.yz = uvToViewParams.xy * v1.xy + uvToViewParams.zw;
	r0.yz = r1.yz * r0.ww;
	{
		float2 noiseSampleCoord = float2(0.03125,0.03125) * v0.xy;
		r1.yzw = randomTexture.Sample(linearSampler_s, noiseSampleCoord).xyz;
		if(LumaSettings.SRType == 1) //only DLSS for now, current spatial denoise makes noise look like features to FSR
		{
			uint2 randomOffset = uint2(RandomFromIndex(LumaSettings.GameSettings.FrameIndex), RandomFromIndex2(LumaSettings.GameSettings.FrameIndex));
			noiseSampleCoord = float2(0.03125,0.03125) * (v0.xy + randomOffset);
			r1.zw = randomTexture.Sample(linearSampler_s, noiseSampleCoord).yz;
		}
		//apply bias from original noise
		r1.y = pow(r1.y, 0.2f);
		r1.y *= 0.3f;
		r1.y += 0.7f;
		r1.z *= 0.7f;
	}
	r2.x = screenParams.z;
	r2.yw = float2(0,0);
	r2.xy = v1.xy + r2.xy;
	r3.x = depthTexture.Sample(pointSampler_s, r2.xy).x;
	r3.x = invProjParams.z + r3.x;
	r3.x = invProjParams.w / r3.x;
	r3.z = -r3.x;
	r2.xy = uvToViewParams.xy * r2.xy + uvToViewParams.zw;
	r3.xy = r2.xy * r3.zz;
	r2.z = -screenParams.z;
	r2.xy = v1.xy + r2.zw;
	r2.z = depthTexture.Sample(pointSampler_s, r2.xy).x;
	r2.z = invProjParams.z + r2.z;
	r2.z = invProjParams.w / r2.z;
	r4.z = -r2.z;
	r2.xy = uvToViewParams.xy * r2.xy + uvToViewParams.zw;
	r4.xy = r2.xy * r4.zz;
	r2.xz = float2(0,0);
	r2.y = screenParams.w;
	r2.xy = v1.xy + r2.xy;
	r3.w = depthTexture.Sample(pointSampler_s, r2.xy).x;
	r3.w = invProjParams.z + r3.w;
	r3.w = invProjParams.w / r3.w;
	r5.z = -r3.w;
	r2.xy = uvToViewParams.xy * r2.xy + uvToViewParams.zw;
	r5.xy = r2.xy * r5.zz;
	r2.w = -screenParams.w;
	r2.xy = v1.xy + r2.zw;
	r2.z = depthTexture.Sample(pointSampler_s, r2.xy).x;
	r2.z = invProjParams.z + r2.z;
	r2.z = invProjParams.w / r2.z;
	r6.z = -r2.z;
	r2.xy = uvToViewParams.xy * r2.xy + uvToViewParams.zw;
	r6.xy = r2.xy * r6.zz;
	r2.xyz = r3.xyz + -r0.yzw;
	r3.xyz = -r4.xyz + r0.yzw;
	r2.w = dot(r2.xyz, r2.xyz);
	r3.w = dot(r3.xyz, r3.xyz);
	r2.w = r2.w < r3.w;
	r2.xyz = r2.www ? r2.xyz : r3.xyz;
	r3.xyz = r5.xyz + -r0.yzw;
	r4.xyz = -r6.xyz + r0.yzw;
	r2.w = dot(r3.xyz, r3.xyz);
	r3.w = dot(r4.xyz, r4.xyz);
	r2.w = r2.w < r3.w;
	r3.xyz = r2.www ? r3.xyz : r4.xyz;
	r2.w = screenParams.y * screenParams.z;
	r3.xyz = r3.xyz * r2.www;
	r4.x = min(4, r1.x);
	r2.w = 1 + r4.x;
	r4.y = r1.x / r2.w;
	r1.x = radiusParams.w / r4.y;
	r2.w = r1.x < r4.x;
	r1.x = r1.x + r1.w;
	r1.x = floor(r1.x);
	r5.x = max(1, r1.x);
	r5.y = radiusParams.w / r5.x;
	r4.xy = r2.ww ? r5.xy : r4.xy;
	r4.yz = screenParams.zw * r4.yy;
	r5.xy = r4.yz * r1.yz;
	r5.zw = screenParams.zw * r1.yz;
	r6.xy = r5.xy * r1.ww;
	r6.xy = screenParams.xy * r6.xy;
	r6.xy = round(r6.xy);
	r6.xy = r6.xy * screenParams.zw + v1.xy;
	r5.xy = screenParams.xy * r5.xy;
	r5.xy = round(r5.xy);
	r6.zw = screenParams.zw * r5.xy;
	r7.xyz = r6.www * r3.xyz;
	r7.xyz = r6.zzz * r2.xyz + r7.xyz;
	r1.x = dot(r7.xy, r7.xy);
	r1.x = rsqrt(r1.x);
	r7.x = -r7.z * r1.x + biasParams.y;
	r5.zw = r1.ww * r6.zw + r5.zw;
	r5.zw = screenParams.xy * r5.zw;
	r5.zw = round(r5.zw);
	r6.zw = screenParams.zw * r5.zw;
	r8.xyz = r6.www * r3.xyz;
	r8.xyz = r6.zzz * r2.xyz + r8.xyz;
	r1.x = dot(r8.xy, r8.xy);
	r1.x = rsqrt(r1.x);
	r1.x = -r8.z * r1.x + biasParams.y;
	r2.w = r1.x * r1.x + 1;
	r2.w = rsqrt(r2.w);
	r2.w = r2.w * r1.x;
	r5.zw = r5.zw * screenParams.zw + v1.xy;
	r3.w = depthTexture.Sample(pointSampler_s, r5.zw).x;
	r3.w = invProjParams.z + r3.w;
	r3.w = invProjParams.w / r3.w;
	r8.z = -r3.w;
	r5.zw = uvToViewParams.xy * r5.zw + uvToViewParams.zw;
	r8.xy = r5.zw * r8.zz;
	r8.xyz = r8.xyz + -r0.yzw;
	r3.w = dot(r8.xy, r8.xy);
	r3.w = rsqrt(r3.w);
	r3.w = -r8.z * r3.w;
	r4.w = r3.w * r3.w + 1;
	r4.w = rsqrt(r4.w);
	r5.z = dot(r8.xyz, r8.xyz);
	r5.w = r5.z < radiusParams.y;
	r1.x = r1.x < r3.w;
	r1.x = r1.x ? r5.w : 0;
	r5.z = r5.z * radiusParams.z + 1;
	r2.w = saturate(r3.w * r4.w + -r2.w);
	r8.y = r5.z * r2.w;
	r8.x = max(r7.x, r3.w);
	r7.yw = float2(0,0);
	r5.zw = r1.xx ? r8.xy : r7.xy;
	r1.x = -1 + r4.x;
	r2.w = r5.z * r5.z + 1;
	r2.w = rsqrt(r2.w);
	r2.w = r5.z * r2.w;
	r3.w = 1 < r1.x;
	if (r3.w != 0) {
		r6.xy = r5.xy * screenParams.zw + r6.xy;
		r4.x = depthTexture.Sample(pointSampler_s, r6.xy).x;
		r4.x = invProjParams.z + r4.x;
		r4.x = invProjParams.w / r4.x;
		r8.z = -r4.x;
		r4.xw = uvToViewParams.xy * r6.xy + uvToViewParams.zw;
		r8.xy = r4.xw * r8.zz;
		r8.xyz = r8.xyz + -r0.yzw;
		r4.x = dot(r8.xy, r8.xy);
		r4.x = rsqrt(r4.x);
		r4.x = -r8.z * r4.x;
		r4.w = dot(r8.xyz, r8.xyz);
		r6.z = r4.w < radiusParams.y;
		r6.w = r5.z < r4.x;
		r6.z = r6.w ? r6.z : 0;
		if (r6.z != 0) {
			r6.z = r4.x * r4.x + 1;
			r6.z = rsqrt(r6.z);
			r6.w = r6.z * r4.x;
			r4.w = r4.w * radiusParams.z + 1;
			r6.z = saturate(r4.x * r6.z + -r2.w);
			r4.w = r4.w * r6.z + r5.w;
			r5.z = r4.x;
			r2.w = r6.w;
		} else {
			r4.w = r5.w;
		}
		r5.w = 2;
	} else {
		r4.w = r5.w;
		r5.w = 1;
	}
	r4.x = r5.w < r1.x;
	if (r4.x != 0) {
		r6.xy = r5.xy * screenParams.zw + r6.xy;
		r6.z = depthTexture.Sample(pointSampler_s, r6.xy).x;
		r6.z = invProjParams.z + r6.z;
		r6.z = invProjParams.w / r6.z;
		r8.z = -r6.z;
		r6.zw = uvToViewParams.xy * r6.xy + uvToViewParams.zw;
		r8.xy = r6.zw * r8.zz;
		r8.xyz = r8.xyz + -r0.yzw;
		r6.z = dot(r8.xy, r8.xy);
		r6.z = rsqrt(r6.z);
		r6.z = -r8.z * r6.z;
		r6.w = dot(r8.xyz, r8.xyz);
		r7.x = r6.w < radiusParams.y;
		r7.y = r5.z < r6.z;
		r7.x = r7.y ? r7.x : 0;
		if (r7.x != 0) {
			r7.x = r6.z * r6.z + 1;
			r7.x = rsqrt(r7.x);
			r7.y = r7.x * r6.z;
			r6.w = r6.w * radiusParams.z + 1;
			r7.x = saturate(r6.z * r7.x + -r2.w);
			r4.w = r6.w * r7.x + r4.w;
			r5.z = r6.z;
			r2.w = r7.y;
		}
		r5.w = 3;
	}
	r6.z = r5.w < r1.x;
	r4.x = r4.x ? r6.z : 0;
	if (r4.x != 0) {
		r6.xy = r5.xy * screenParams.zw + r6.xy;
		r6.z = depthTexture.Sample(pointSampler_s, r6.xy).x;
		r6.z = invProjParams.z + r6.z;
		r6.z = invProjParams.w / r6.z;
		r8.z = -r6.z;
		r6.zw = uvToViewParams.xy * r6.xy + uvToViewParams.zw;
		r8.xy = r6.zw * r8.zz;
		r8.xyz = r8.xyz + -r0.yzw;
		r6.z = dot(r8.xy, r8.xy);
		r6.z = rsqrt(r6.z);
		r6.z = -r8.z * r6.z;
		r6.w = dot(r8.xyz, r8.xyz);
		r7.x = r6.w < radiusParams.y;
		r7.y = r5.z < r6.z;
		r7.x = r7.y ? r7.x : 0;
		if (r7.x != 0) {
			r7.x = r6.z * r6.z + 1;
			r7.x = rsqrt(r7.x);
			r7.y = r7.x * r6.z;
			r6.w = r6.w * radiusParams.z + 1;
			r7.x = saturate(r6.z * r7.x + -r2.w);
			r4.w = r6.w * r7.x + r4.w;
			r5.z = r6.z;
			r2.w = r7.y;
		}
		r5.w = 4;
	}
	r5.w = r5.w < r1.x;
	r4.x = r4.x ? r5.w : 0;
	if (r4.x != 0) {
		r5.xy = r5.xy * screenParams.zw + r6.xy;
		r4.x = depthTexture.Sample(pointSampler_s, r5.xy).x;
		r4.x = invProjParams.z + r4.x;
		r4.x = invProjParams.w / r4.x;
		r6.z = -r4.x;
		r5.xy = uvToViewParams.xy * r5.xy + uvToViewParams.zw;
		r6.xy = r5.xy * r6.zz;
		r5.xyw = r6.xyz + -r0.yzw;
		r4.x = dot(r5.xy, r5.xy);
		r4.x = rsqrt(r4.x);
		r4.x = -r5.w * r4.x;
		r5.x = dot(r5.xyw, r5.xyw);
		r5.y = r5.x < radiusParams.y;
		r5.z = r5.z < r4.x;
		r5.y = r5.z ? r5.y : 0;
		if (r5.y != 0) {
			r5.y = r4.x * r4.x + 1;
			r5.y = rsqrt(r5.y);
			r5.x = r5.x * radiusParams.z + 1;
			r2.w = saturate(r4.x * r5.y + -r2.w);
			r4.w = r5.x * r2.w + r4.w;
		}
	}
	r5.xy = float2(0.707106769,0.707106769) * r1.yz;
	r6.x = r1.y * 0.707106769 + -r5.y;
	r6.y = r5.y + r5.x;
	r5.zw = r6.xy * r4.yz;
	r6.zw = r5.zw * r1.ww;
	r6.xyzw = screenParams.zwxy * r6.xyzw;
