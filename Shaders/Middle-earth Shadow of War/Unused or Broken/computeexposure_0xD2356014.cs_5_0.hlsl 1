//
// ExposureTonemap_CS.hlsl
// Compute shader: calculates scene exposure (median luminance from a tile texture)
// and computes coefficients for a modified Reinhard-like SDR tonemapper.
//
// Resources:
//   t0         : Texture2D<float4>  – per-tile luminance/luma texture
//   u0         : RWBuffer<float4>   – output: exposure / tonemapper coefficients [0..5]
//   u1         : RWBuffer<float4>   – output: second set of tonemapper coefficients [0..5]
//   CB3[0]     : (x=width, y=height, zw=unused)
//   CB3[1]     : (x=maxLog, y=gamma0, z=gamma1, w=unused)
//   CB3[2]     : (x=minLum0, y=minLum1, z=minExposure, w=minLum2)
//   CB3[3]     : (x=maxExposure, y=maxLum2, z=maxLum0, w=maxLum1)
//   CB3[4]     : (x=white0, y=white1, z=normScale0, w=normScale1)
//

Texture2D<float4>   t0 : register(t0);
RWBuffer<float4>    u0 : register(u0);
RWBuffer<float4>    u1 : register(u1);

cbuffer CB3 : register(b3)
{
    float4 CB3_0; // x = tileWidth,   y = tileHeight
    float4 CB3_1; // x = maxLog,      y = gamma0,    z = gamma1
    float4 CB3_2; // x = minLum0,     y = minLum1,   z = minExposure, w = minLum2
    float4 CB3_3; // x = maxExposure, y = maxLum2,   z = maxLum0,     w = maxLum1
    float4 CB3_4; // x = white0,      y = white1,    z = normScale0,  w = normScale1
}

groupshared float g0[256];

// Helper: sample luminance from tile texture at linear index idx,
// returning 1e6 if out of range.
// The original fetches the .y swizzle component (green / luminance channel).
float SampleTile(uint idx, uint totalTiles)
{
    if (idx < totalTiles)
    {
        float fi = (float)idx;
        float w  = CB3_0.x;

        // Absolute-value division to get integer column and fractional row
        // (mirrors the ge/movc abs-value trick in the disasm)
        float absW   = (fi * w >= -(fi * w)) ? w : -w;
        float invAbsW = 1.0f / absW;
        float col    = frac(fi * invAbsW) * absW;
        float row    = floor(fi / w);

        uint2 coord  = uint2((uint)col, (uint)row);
        return t0.Load(int3(coord, 0)).y;  // .yzxw swizzle -> .y component
    }
    return 1000000.0f;
}

[numthreads(128, 1, 1)]
void main(uint3 vThreadID : SV_DispatchThreadID)
{
    uint tid = vThreadID.x;

    // -------------------------------------------------------------------------
    // Phase 1: Each thread loads two elements into groupshared memory.
    //          Indices: even = tid*2, odd = tid*2+1
    // -------------------------------------------------------------------------
    uint totalTiles = (uint)(CB3_0.y * CB3_0.x);

    uint idx0 = tid * 2;
    uint idx1 = tid * 2 + 1;

    g0[idx0] = SampleTile(idx0, totalTiles);
    g0[idx1] = SampleTile(idx1, totalTiles);

    GroupMemoryBarrierWithGroupSync();

    // -------------------------------------------------------------------------
    // Phase 2: Initial compare-and-swap on the two loaded elements.
    // -------------------------------------------------------------------------
    float v0 = g0[idx0];
    float v1 = g0[idx1];

    if (v1 < v0)
    {
        g0[idx0] = v1;
        g0[idx1] = v0;
    }

    GroupMemoryBarrierWithGroupSync();

    // -------------------------------------------------------------------------
    // Phase 3: Bitonic sort across the full 256-element shared array.
    //
    // Outer loop doubles the sub-sequence size k (4, 8, 16, ... up to 256).
    // Inner loop does the comparisons for each level of the butterfly.
    // -------------------------------------------------------------------------
    for (uint k = 4; k <= 256; k <<= 1)
    {
        // Outer butterfly pass for sub-sequence size k
        {
            uint halfK   = k >> 1;
            uint blockId = tid / halfK;
            uint posA    = blockId * k + (tid % halfK);        // = imad(blockId, k, tid%halfK)  → r0.w
            uint posB    = blockId * k + k - 1 - (tid % halfK); // complementary index          → r1.x

            // posB recomputed from disasm: imad(blockId,k,k) - (tid%halfK) - 1
            // i.e. iadd(iadd(imad(blockId,k,k), -tid%halfK), -1)

            float va = g0[posB];
            float vb = g0[posA];

            if (va < vb)
            {
                g0[posA] = va;
                g0[posB] = vb;
            }

            GroupMemoryBarrierWithGroupSync();
        }

        // Inner merge passes (sub-sequence size shrinks: halfK, halfK/2, ... 2)
        for (uint subK = k >> 1; subK >= 2; subK >>= 1)
        {
            uint halfSub = subK >> 1;
            uint blockId = tid / halfSub;
            uint posA    = blockId * subK + (tid % halfSub);   // → r1.y
            uint posB    = posA + halfSub;                     // → r1.z

            float va = g0[posA];
            float vb = g0[posB];

            if (vb < va)
            {
                g0[posA] = vb;
                g0[posB] = va;
            }

            GroupMemoryBarrierWithGroupSync();
        }
    }

    // -------------------------------------------------------------------------
    // Phase 4: Thread 0 reads the median and computes all outputs.
    // -------------------------------------------------------------------------
    if (tid == 0)
    {
        // --- Median luminance ---
        // If totalTiles is odd, median is the center element.
        // If even, median is average of the two center elements.
        float median;
        if (totalTiles & 1)
        {
            median = g0[totalTiles >> 1];
        }
        else
        {
            uint  half = totalTiles >> 1;
            float lo   = g0[half];
            float hi   = g0[half + 1];
            median = (lo + hi) * 0.5f;
        }
        median = max(median, 1e-5f);

        // -----------------------------------------------------------------------
        // Exposure / tonemapper computations
        // Uses log-space clamping: if |log(ratio)| > maxLog, clamp to ±maxLog.
        // -----------------------------------------------------------------------

        // --- u0 source: current auto-exposure value ---
        float curExposure = u0[0].y;   // read back current exposure from u0[0]

        // Clamp raw exposure to [minExposure, maxExposure]
        float2 medianScaled = median / CB3_4.zw;                           // div by normScale0, normScale1
        medianScaled = clamp(medianScaled, CB3_2.zz, CB3_3.xx);           // [minExposure, maxExposure]
        curExposure  = clamp(curExposure,  CB3_2.z,  CB3_3.x);

        // Log-space step for u0 dimension 0: ratio = medianScaled.x / curExposure
        float ratio0  = medianScaled.x / curExposure;
        float logR0   = log2(ratio0);       // shader uses log (natural log base-e; approximated here as log2 for readability—actual is base-e)
        float sign0   = (logR0 > 0.0f) ? 1.0f : ((logR0 < 0.0f) ? -1.0f : 0.0f);
        if (abs(logR0) > CB3_1.x)
            logR0 = sign0 * CB3_1.x;
        float newExposure0 = exp2(logR0) * curExposure;

        // Apply gamma0 in log space
        float logE0 = log2(newExposure0);
        float E0    = exp2(logE0 * CB3_1.y);  // pow(newExposure0, gamma0)

        // Compute minLum0 and minLum1 raised to gamma0
        float2 logMin01  = log2(CB3_2.xy);
        float2 minG01    = exp2(logMin01 * CB3_1.yy);   // pow(minLum0, gamma0), pow(minLum1, gamma0) – but only .xz used

        float rangeW0    = minG01.x - E0;   // r1.w  (add -E0 + minG01.x)
        rangeW0          = max(rangeW0, 1e-5f);

        // Coefficient 1 for u0 (index 1): (minG01.x/white0 - E0/maxLum0) / rangeW0
        float coeff0_u0  = (minG01.x / CB3_4.x  -  E0 / CB3_3.z) / rangeW0;   // r2.x

        // Coefficient 2 for u0 (index 2): (E0*minG01.x/maxLum0 - E0*minG01.x/white0) / rangeW0
        float E0min0     = E0 * minG01.x;
        float coeff2_u0  = (E0min0 / CB3_3.z  -  E0min0 / CB3_4.x) / rangeW0;  // r0.w

        // --- u1 source: secondary exposure value ---
        float curLum1 = u1[0].x;
        curLum1       = clamp(curLum1, CB3_2.w, CB3_3.y);

        // Log-space step for u1 dimension 0: ratio = medianScaled.y / curLum1
        float ratio1  = medianScaled.y / curLum1;
        float logR1   = log2(ratio1);
        float sign1   = (logR1 > 0.0f) ? 1.0f : ((logR1 < 0.0f) ? -1.0f : 0.0f);
        if (abs(logR1) > CB3_1.x)
            logR1 = sign1 * CB3_1.x;
        float newLum1 = exp2(logR1) * curLum1;

        // Apply gamma1 in log space
        float logL1 = log2(newLum1);
        float L1    = exp2(logL1 * CB3_1.z);  // pow(newLum1, gamma1)

        // Compute minLum1 raised to gamma1 (reuse minG01.y ~ r1.z)
        float minG1   = exp2(log2(CB3_2.y) * CB3_1.z);   // pow(minLum1, gamma1)

        float rangeW1 = minG1 - L1;
        rangeW1       = max(rangeW1, 1e-5f);

        // Coefficient 1 for u1 (index 1): (minG1/white1 - L1/maxLum1) / rangeW1
        float coeff1_u1 = (minG1 / CB3_4.y  -  L1 / CB3_3.w) / rangeW1;   // r2.y

        // Coefficient 2 for u1 (index 2): (L1*minG1/maxLum1 - L1*minG1/white1) / rangeW1
        float L1min1    = L1 * minG1;
        float coeff2_u1 = (L1min1 / CB3_3.w  -  L1min1 / CB3_4.y) / rangeW1;  // r1.y

        // -----------------------------------------------------------------------
        // Write outputs (only if not NaN/Inf — the shader checks for infinity bits)
        // -----------------------------------------------------------------------
        // u0[0] = curExposure (passthrough, only if finite)
        if (isfinite(curExposure))
            u0[0] = curExposure;

        // u0[1] = coeff0_u0
        if (isfinite(coeff0_u0))
            u0[1] = coeff0_u0;

        // u0[2] = coeff2_u0
        if (isfinite(coeff2_u0))
            u0[2] = coeff2_u0;

        // u1[0] = curLum1
        if (isfinite(curLum1))
            u1[0] = curLum1;

        // u1[1] = coeff1_u1
        if (isfinite(coeff1_u1))
            u1[1] = coeff1_u1;

        // u1[2] = coeff2_u1
        if (isfinite(coeff2_u1))
            u1[2] = coeff2_u1;

        // -----------------------------------------------------------------------
        // Median value (g0[0] = minimum of sorted array), normalized — u0[3..5] / u1[3..5]
        // -----------------------------------------------------------------------
        float sortedMin = g0[0];
        float2 normMin  = sortedMin / CB3_4.zw;    // div by normScale0, normScale1

        u0[3] = normMin.x;
        u0[4] = median;           // raw median (r0.y was preserved)
        
        // Last element of sorted array = maximum sample
        float sortedMax    = g0[totalTiles - 1];
        float2 normMax     = sortedMax / CB3_4.zw;

        u0[5] = normMax.x;
        u1[3] = normMin.y;
        u1[4] = median;           // same raw median, second buffer
        u1[5] = normMax.y;
    }
}






